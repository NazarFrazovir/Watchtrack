# Скопіюйте у .env, якщо потрібно змінити значення за замовчуванням.
POSTGRES_USER=watchtrack
POSTGRES_PASSWORD=watchtrack
POSTGRES_DB=watchtrack
DB_PORT=5433
API_PORT=8000
WEB_CONCURRENCY=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
SEED_DEMO_DATA=true
LOG_LEVEL=INFO

# Для запуску API локально без Docker (БД з docker compose доступна на порту 5433):
# DATABASE_URL=postgresql+asyncpg://watchtrack:watchtrack@localhost:5433/watchtrack
